rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null &&
        exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    // Admin roster: doc id == the admin's Firebase Auth uid (separate,
    // secondary sign-in from the passenger/driver anonymous session — see
    // src/lib/firebase.ts). An admin may only read their own doc, to
    // resolve their role on login. No client can ever write here — admins
    // are provisioned manually via the Firebase console.
    match /admins/{adminId} {
      allow read: if request.auth != null && request.auth.uid == adminId;
      allow write: if false;
    }

    // Users can read any profile (drivers/passengers need to see each other's
    // public info), but only write their own document. A real, verified
    // admin may additionally flip a driver's KYC/approval fields.
    match /users/{userId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.auth.uid == userId;
      allow update: if request.auth != null && (
        request.auth.uid == userId ||
        (isAdmin() && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['approvalStatus', 'kycStatus', 'rejectionReason', 'updatedAt']))
      );
      allow delete: if false;
    }

    // Rides are visible to authenticated users (needed for the live "active
    // rides" / driver dispatch feed); only the passenger who owns the ride or
    // the driver assigned to it can modify it.
    match /rides/{rideId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && request.resource.data.passengerId == request.auth.uid;
      allow update: if request.auth != null
        && (resource.data.passengerId == request.auth.uid
            || resource.data.driverId == request.auth.uid);
      allow delete: if false;
    }

    // Ride history: each user can only read/write entries tagged with their
    // own userId.
    match /history/{historyId} {
      allow read: if request.auth != null
        && resource.data.userId == request.auth.uid;
      allow create: if request.auth != null
        && request.resource.data.userId == request.auth.uid;
      allow update, delete: if false;
    }

    // Wallet transactions: append-only ledger, readable/writable only by the
    // owning user.
    match /transactions/{txId} {
      allow read: if request.auth != null
        && resource.data.userId == request.auth.uid;
      allow create: if request.auth != null
        && request.resource.data.userId == request.auth.uid;
      allow update, delete: if false;
    }

    // System settings (pricing, notification schedule): readable by any
    // signed-in client (passengers need live pricing to compute fares),
    // writable only by a real, Firebase-Auth-verified admin.
    match /settings/{settingsId} {
      allow read: if request.auth != null;
      allow write: if isAdmin();
    }

    // Broadcast notifications: readable by any signed-in user. Creating (or
    // fully editing) one is admin-only; any signed-in user may still update
    // just the `readBy` field to mark a notification read for themselves.
    match /notifications/{notificationId} {
      allow read: if request.auth != null;
      allow create: if isAdmin();
      allow update: if request.auth != null && (
        isAdmin() ||
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['readBy'])
      );
      allow delete: if false;
    }

    // Deny everything else by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
