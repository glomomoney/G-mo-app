{
  "entities": {
    "users": {
      "title": "Users",
      "description": "User accounts and profiles",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "email": { "type": "string" },
        "phone": { "type": "string" },
        "role": { "type": "string" },
        "avatar": { "type": "string" },
        "walletBalance": { "type": "number" },
        "createdAt": { "type": "string" }
      },
      "required": ["name"]
    },
    "rides": {
      "title": "Rides",
      "description": "Live ride requests and bookings",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "passengerId": { "type": "string" },
        "passengerName": { "type": "string" },
        "passengerPhone": { "type": "string" },
        "pickup": { "type": "object" },
        "destination": { "type": "object" },
        "fare": { "type": "number" },
        "paymentMethod": { "type": "string" },
        "rideClassId": { "type": "string" },
        "status": { "type": "string" },
        "driverId": { "type": "string" },
        "driverName": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["passengerName", "pickup", "destination", "fare", "status"]
    },
    "history": {
      "title": "Ride History",
      "description": "Completed and cancelled ride records",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "date": { "type": "string" },
        "pickupName": { "type": "string" },
        "destName": { "type": "string" },
        "fare": { "type": "number" },
        "paymentMethod": { "type": "string" },
        "status": { "type": "string" },
        "vehicleClass": { "type": "string" },
        "driverName": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["pickupName", "destName", "fare", "status"]
    },
    "settings": {
      "title": "System Settings & Pricing Rates",
      "description": "Global pricing configuration including base fares, per-km rates, and commission percentages",
      "type": "object",
      "properties": {
        "commissionRate": { "type": "number" },
        "surgeMultiplier": { "type": "number" },
        "minimumWithdrawal": { "type": "number" },
        "topupPromoActive": { "type": "boolean" },
        "topupPromoRate": { "type": "number" },
        "classRates": { "type": "object" },
        "updatedAt": { "type": "string" }
      }
    },
    "notifications": {
      "title": "Push Notifications",
      "description": "Broadcast push notifications sent to passengers and drivers",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "target": { "type": "string" },
        "title": { "type": "string" },
        "message": { "type": "string" },
        "type": { "type": "string" },
        "timestamp": { "type": "string" },
        "language": { "type": "string" }
      },
      "required": ["target", "title", "message"]
    }
  },
  "firestore": {
    "/settings/{settingsId}": {
      "schema": { "$ref": "#/entities/settings" },
      "description": "System configuration documents such as pricing"
    },
    "/notifications/{notificationId}": {
      "schema": { "$ref": "#/entities/notifications" },
      "description": "Push notification messages"
    }
  }
}
